# Copy to .env.local. NEXT_PUBLIC_ values are inlined into the browser bundle
# at build time, so never put a secret here.

# The FastAPI backend (uv run python main.py). Its CORS_ORIGINS must include
# this app's origin, which is http://localhost:3000 by default.
NEXT_PUBLIC_API_URL=http://localhost:8000

# The Streamlit UI, which keeps the Reports page until this app has its own.
NEXT_PUBLIC_STREAMLIT_URL=http://localhost:8501
