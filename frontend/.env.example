# Copy to .env.local. These are read by this app's server, never sent to the
# browser: the pages call the API through the app's own /api route, which
# forwards each call with the key. .env.local is ignored by git: keep the key
# there, never in this file.

# The FastAPI backend (uv run python main.py).
BACKEND_URL=http://localhost:8000
# The API's key: the same value as API_KEY in the backend's .env. Leave both
# empty to run without one on your own machine.
API_KEY=
# The largest request body the app forwards, in bytes: the API's own limit.
# Uncomment to change the default shown.
# MAX_REQUEST_BYTES=1000000
