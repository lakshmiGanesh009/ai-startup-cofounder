# Workflow debugging flag: DEBUG logging now, LangGraph step-by-step traces from Step 2.
DEBUG_MODE=false

# LLM credentials. Not read by the scaffold; llm.py uses them from Step 1 of
# DEVELOPMENT_PLAN.md, which also settles the variables for any other provider.
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
# Only used by reasoning models (gpt-5 family, o-series): minimal | low | medium | high
AZURE_OPENAI_REASONING_EFFORT=minimal
