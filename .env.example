# Workflow debugging flag: DEBUG logging plus LangGraph step-by-step traces.
DEBUG_MODE=false

# Loop and LLM limits. Uncomment to change the defaults shown.
# Revisions allowed for a report the Chief of Staff rejects.
# MAX_ITERATIONS=1
# Cross-critique rounds.
# MAX_CRITIQUE_ROUNDS=1
# Seconds per LLM call, and retries for a failed call. Calls at high reasoning
# take longer, so they get LLM_TIMEOUT_HIGH instead.
# LLM_TIMEOUT=120
# LLM_TIMEOUT_HIGH=300
# LLM_MAX_RETRIES=2

# Web research, for preparing a brief and for deep research, runs on Azure
# OpenAI's own web search (Bing, billed to Azure per search) with the settings
# below, or on Tavily for demanding tasks; the sidebar switches between them.
# Tavily needs a key (free at https://tavily.com: 1,000 credits a month; a
# brief's searches use two to four). Seconds to wait for one search:
TAVILY_API_KEY=
# SEARCH_TIMEOUT=20
# Deep research (a switch on the Evaluate page) runs one Tavily research task per
# specialist and per competitor: 20-90 s and 20-80 credits each with the "mini"
# model, so about 150-450 credits an evaluation. Seconds to wait for one task:
# RESEARCH_TIMEOUT=300

# The frontend. Uncomment to change the default shown.
# Browser origins allowed to call the API, comma-separated (the Next.js app).
# CORS_ORIGINS=http://localhost:3000

# LLM provider. The provider is chosen by which credentials are set below:
# Azure OpenAI is used when AZURE_OPENAI_API_KEY is present, otherwise OpenAI.
# Fill in exactly one block.

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
# Only used by reasoning models (gpt-5 family, o-series): minimal | low | medium |
# high. The first applies to the four specialists; the second to the Chief of
# Staff's decisions (plan, review, resolving conflicts, synthesis) and defaults to
# the first when unset. Measured on 2026-10-16 with gpt-5-mini, an evaluation takes
# about 1.5-2 minutes with the Chief of Staff at medium and 5-10 minutes at high,
# the most it actually reasons. The API also accepts xhigh, but gpt-5-mini then
# does no reasoning at all, so do not use it with this model. These are the
# defaults: the UI's sliders (or a request's "reasoning") can choose others.
AZURE_OPENAI_REASONING_EFFORT=minimal
AZURE_OPENAI_CHIEF_REASONING_EFFORT=medium

# --- OpenAI ---
# OPENAI_API_KEY=your-openai-api-key
# MODEL_NAME=gpt-4o-mini
