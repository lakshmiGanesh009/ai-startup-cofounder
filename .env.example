# Workflow debugging flag: DEBUG logging plus LangGraph step-by-step traces.
DEBUG_MODE=false
# Log lines as text, or as one JSON object a line for a log collector (json).
# Either way each names its request (the X-Request-ID header) and session.
# LOG_FORMAT=text

# Where sessions, reports and the Monitor's history are kept, so a restart loses
# none of them: a PostgreSQL database (create it with `createdb cofounder`). The
# API does not start if it cannot reach it. Unset, they are kept in memory and
# lost when the API stops.
DATABASE_URL=postgresql://localhost:5432/cofounder
# A database the PostgreSQL tests may empty (createdb cofounder_test); without
# it those tests are skipped.
# TEST_DATABASE_URL=postgresql://localhost:5432/cofounder_test
# For Docker: the password of the PostgreSQL it runs (it points the API's
# DATABASE_URL there itself). ./start.sh docker offers to make one here; or make
# one as for API_KEY below.
POSTGRES_PASSWORD=

# Loop and LLM limits. Uncomment to change the defaults shown.
# Revisions allowed for a report the Chief of Staff rejects.
# MAX_ITERATIONS=1
# Cross-critique rounds.
# MAX_CRITIQUE_ROUNDS=1
# Seconds per LLM call, and retries for a failed call. Calls at high reasoning
# take longer, so they get LLM_TIMEOUT_HIGH instead.
# LLM_TIMEOUT=120
# LLM_TIMEOUT_HIGH=300
# LLM_MAX_RETRIES=2

# Web research, for preparing a brief and for deep research, runs on Azure
# OpenAI's own web search (Bing, billed to Azure per search) with the settings
# below, or on Tavily for demanding tasks; the sidebar switches between them.
# Tavily needs a key (free at https://tavily.com: 1,000 credits a month; a
# brief's searches use two to four). Seconds to wait for one search:
TAVILY_API_KEY=
# SEARCH_TIMEOUT=20
# Deep research (a switch on the Evaluate page) runs one Tavily research task per
# specialist and per competitor: 20-90 s and 20-80 credits each with the "mini"
# model, so about 150-450 credits an evaluation. Seconds to wait for one task:
# RESEARCH_TIMEOUT=300

# Official figures. With a FRED key (free at https://fredaccount.stlouisfed.org:
# sign up, then API Keys), the team reads the St. Louis Fed's figures its plan
# turns on through the app's own FRED MCP server (fred_server.py): the 10-year
# Treasury yield, inflation and a few series the Chief of Staff picks. With deep
# research on Tavily, each competitor's own pricing page is read through
# Tavily's MCP server too (about 4 more credits). Seconds a look-up may take:
FRED_API_KEY=
# LOOKUP_TIMEOUT=30
# TAVILY_MCP_URL=https://mcp.tavily.com/mcp/

# Langfuse (https://langfuse.com): every model call traced, the prompts versioned,
# the team's scores and the founder's verdicts. Create a project (Langfuse Cloud's
# free plan is enough) and copy its keys from the project's settings. Without them
# nothing is traced and nothing leaves the app. Emails, phone numbers, card numbers
# and keys are masked before anything is sent.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# The region: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com (US),
# or your own server.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Filters in Langfuse: where traces come from, and which version of the app sent them.
# LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_RELEASE=
# The share of requests traced, from 0 to 1 (all of them by default).
# LANGFUSE_SAMPLE_RATE=1.0
# An LLM judge scores each live strategy too (judge.py), one more call a run.
# LANGFUSE_JUDGE=false

# Access. The key every caller must send (Authorization: Bearer <key>) for
# anything but /health; put the same value in frontend/.env.local, whose server
# adds it to the pages' calls, so it never reaches a browser (./start.sh and
# Docker hand it over themselves). Make one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# and keep it out of version control (.env is ignored). Left empty, the API is
# open to anyone who can reach it: fine on your own machine only.
API_KEY=

# Limits, so one caller cannot exhaust the API or the model deployment.
# Uncomment to change the defaults shown. The largest request body, in bytes;
# requests a minute and runs (evaluations, briefs, proposals) an hour per
# caller; and runs at once, beyond which they are refused until one ends.
# MAX_REQUEST_BYTES=1000000
# REQUESTS_PER_MINUTE=300
# RUNS_PER_HOUR=30
# MAX_CONCURRENT_RUNS=4

# Browser origins allowed to call the API directly, comma-separated. The
# frontend does not need this: its pages call the API through its own server.
# CORS_ORIGINS=http://localhost:3000

# LLM provider. The provider is chosen by which credentials are set below:
# Azure OpenAI is used when AZURE_OPENAI_API_KEY is present, otherwise OpenAI.
# Fill in exactly one block.

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
# Only used by reasoning models (gpt-5 family, o-series): minimal | low | medium |
# high. The first applies to the four specialists; the second to the Chief of
# Staff's decisions (plan, review, resolving conflicts, synthesis) and defaults to
# the first when unset. Measured on 2026-10-16 with gpt-5-mini, an evaluation takes
# about 1.5-2 minutes with the Chief of Staff at medium and 5-10 minutes at high,
# the most it actually reasons. The API also accepts xhigh, but gpt-5-mini then
# does no reasoning at all, so do not use it with this model. These are the
# defaults: the UI's sliders (or a request's "reasoning") can choose others.
AZURE_OPENAI_REASONING_EFFORT=minimal
AZURE_OPENAI_CHIEF_REASONING_EFFORT=medium
# Dictation: the mic beside the app's input boxes. Deploy Whisper on the same
# resource, the speech-to-text model that also translates: whatever language is
# spoken, it comes back in English. Named "whisper" (Azure's default) it needs
# nothing here; under another name, name it below. A model that cannot
# translate (gpt-4o-transcribe) writes the words down as spoken instead.
# AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=whisper
# AZURE_OPENAI_TRANSCRIPTION_API_VERSION=2024-10-21

# --- OpenAI ---
# OPENAI_API_KEY=your-openai-api-key
# MODEL_NAME=gpt-4o-mini
